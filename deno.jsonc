{
  "tasks": {
    "build": "npm run build",
    "dev": "npm run dev"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any"]
    }
  },
  "fmt": {
    "options": {
      "useTabs": false,
      "lineWidth": 80,
      "indentWidth": 2,
      "singleQuote": false
    }
  },
  "imports": {
    "@std/encoding": "jsr:@std/encoding@^0.224.0",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.2.0",
    "@tailwindcss/postcss": "npm:@tailwindcss/postcss@^4.3.2",
    "postcss": "npm:postcss@^8.5.17",
    "svelte": "npm:svelte@^5.56.4",
    "tailwindcss": "npm:tailwindcss@^4.3.2",
    "vite": "npm:vite@^8.1.4",
    "vite-plugin-singlefile": "npm:vite-plugin-singlefile@^2.3.3"
  }
}
