{
  "tasks": {
    "build": "npm run build",
    "dev": "npm run dev"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any"]
    }
  },
  "fmt": {
    "options": {
      "useTabs": false,
      "lineWidth": 80,
      "indentWidth": 2,
      "singleQuote": false
    }
  },
  "imports": {
    "@std/encoding": "jsr:@std/encoding@^0.224.0",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^3.1.0",
    "autoprefixer": "npm:autoprefixer@^10.4.19",
    "postcss": "npm:postcss@^8.4.38",
    "svelte": "npm:svelte@^4.2.12",
    "tailwindcss": "npm:tailwindcss@^3.4.17",
    "vite": "npm:vite@^5.2.11",
    "vite-plugin-singlefile": "npm:vite-plugin-singlefile@^2.0.1"
  }
}
