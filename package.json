{
  "name": "gascalc",
  "version": "1.3.1",
  "description": "酸素・窒素ガス使用量計算ツール",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/rename-build.mjs",
    "dev": "vite",
    "lint": "biome check .",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "overrides": {
    "picomatch@<2.3.2": "2.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/svelte": "^5.4.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.17",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
