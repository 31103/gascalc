{
  "name": "gascalc",
  "version": "1.1.0",
  "description": "酸素・窒素ガス使用量計算ツール",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/rename-build.mjs",
    "dev": "vite",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "autoprefixer": "^10.4.19",
    "husky": "^9.1.7",
    "postcss": "^8.4.38",
    "svelte": "^4.2.12",
    "tailwindcss": "^3.4.17",
    "vite": "^5.2.11",
    "vite-plugin-singlefile": "^2.0.1",
    "vitest": "^3.1.0"
  }
}
